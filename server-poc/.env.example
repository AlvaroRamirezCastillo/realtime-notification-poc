PORT=3000

# Copia este archivo a .env dentro de server-poc y completa estos valores.
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_DATABASE_URL=https://TU-DATABASE-URL

# Ruta absoluta a un archivo de credenciales privado que ya tengas.
# applicationDefault() lee esta variable; no pegues aquí el contenido del JSON.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/firebase-admin.json
