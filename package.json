{
  "name": "realtime-notifications-poc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:client": "pnpm --filter client-poc dev",
    "dev:server": "pnpm --filter server-poc dev",
    "build": "pnpm --recursive run build"
  }
}
